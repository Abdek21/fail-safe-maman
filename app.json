{
  "expo": {
    "name": "Fail-Safe",
    "slug": "fail-safe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E3F2FD"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.failsafe.medications",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Pour photographier la boîte de médicaments.",
        "NSPhotoLibraryUsageDescription": "Pour sélectionner une photo depuis la galerie.",
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "NSUserNotificationsUsageDescription": "Pour envoyer les rappels de médicaments."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E3F2FD"
      },
      "package": "com.failsafe.medications",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#1565C0",
          "mode": "production"
        }
      ],
      "expo-camera",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "67bea56b-76e3-47dd-9709-ac60102593eb"
      }
    }
  }
}